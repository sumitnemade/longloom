# LongLoom — provider credentials & runtime configuration
# Copy to .env (never commit .env) and fill in what you use.

# ── LLM providers ────────────────────────────────────────────────────
# NVIDIA (https://integrate.api.nvidia.com/)
NVIDIA_API_KEY=
# OpenAI (https://platform.openai.com/)
# OPENAI_API_KEY=
# Anthropic
# ANTHROPIC_API_KEY=
# Groq / Mistral / DeepSeek / Together — same pattern as the provider name

# ── Model selection (defaults shown) ─────────────────────────────────
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# OPENAI_MODEL=gpt-4o-mini

# ── Storage endpoints (used by examples / tests) ─────────────────────
# PostgreSQL (examples 08/14/15; else docker ei-postgres on :5433 is probed)
# LONGCTX_PG_DSN=postgresql://user:password@host:5432/longloom
# MySQL / MariaDB (examples 09/14/15; else user-space :3307 is probed)
# LONGCTX_MYSQL_DSN=mysql://user:password@host:3306/longloom
# MongoDB (examples 10/14/15; default mongodb://127.0.0.1:27017)
# LONGCTX_MONGO_URI=mongodb://127.0.0.1:27017
# Supabase (example 11; REST via supabase-py)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_KEY=
# Redis (example 12 custom store; default redis://127.0.0.1:6379/0)
# REDIS_URL=redis://127.0.0.1:6379/0